# Copy to .env on the server and fill in. NEVER commit .env.
#
# Host directory that becomes /data in the container: the SSD tier
# (/data/drops) plus state.db. A fresh install can use ./data; this
# deployment points it at the checkout itself.
FOURDOTS_DATA_DIR=./data

# The external Docker network shared with your tunnel container. The app
# joins it and is reachable there by its container name, "4dots".
FOURDOTS_NETWORK=4dots_default

# Size of the tmpfs RAM tier, in MB. Set this to roughly half of the memory
# you are willing to give the RAM tier, and keep it below the amount the
# server actually has free. The server refuses to use the RAM tier when free
# memory drops below FOURDOTS_RAM_MIN_MB (2048 MB by default).
FOURDOTS_RAM_DISK_MB=1024

# There is deliberately no tunnel token here: the tunnel in this deployment is
# managed by its own config file + credentials (see DEPLOY-MAP.md). If you run
# a token-managed tunnel instead, keep its token in .env and never commit it.
