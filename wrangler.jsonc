// 4dots on Cloudflare Workers. Deploy with `npm run deploy`.
// Secret to set once: `npx wrangler secret put NIMBO_TOKEN` (your nimbo.fun API key).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "4dots",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // Served only on the custom domain. Set both to true for a free workers.dev address.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/share"]
  },
  "durable_objects": {
    "bindings": [{ "name": "REGISTRY", "class_name": "Registry" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Registry"] }],
  "vars": {
    "NIMBO_BASE_URL": "https://nimbo.fun",
    "NIMBO_FOLDER": "drop",
    "MAX_UPLOAD_MB": "1024",
    "PART_MB": "90"
  },
  "observability": { "enabled": true }
}
